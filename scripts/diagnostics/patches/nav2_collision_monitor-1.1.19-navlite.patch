+
+void CollisionMonitor::logNavlite(const Action & action, bool published, const char * reason)
+{
+  const char * name = action.action_type == STOP ? "STOP" :
+    action.action_type == SLOWDOWN ? "SLOWDOWN" :
+    action.action_type == APPROACH ? "APPROACH" : "DO_NOTHING";
+  const bool zero = action.req_vel.isZero();
+  const std::string key = std::string(name) + ":" + navlite_region_ +
+    (zero ? ":zero" : ":nonzero") + (published ? ":published:" : ":suppressed:") +
+    reason + ":" + navlite_sources_;
+  const auto stamp = std::chrono::steady_clock::now();
+  if (navlite_seen_ && key == navlite_key_ &&
+    ((!zero && action.action_type == DO_NOTHING && published &&
+    navlite_sources_.find("timeout") == std::string::npos &&
+    navlite_sources_.find("unavailable") == std::string::npos &&
+    navlite_sources_.find("no_message") == std::string::npos) ||
+    stamp - navlite_last_ < std::chrono::seconds(1)))
+  {
+    return;
+  }
+  const std::string previous = navlite_seen_ ? navlite_key_ : "unobserved";
+  navlite_seen_ = true;
+  navlite_key_ = key;
+  navlite_last_ = stamp;
+  RCLCPP_WARN(get_logger(),
+    "NAVLITE collision action=%s region=%s published=%d zero=%d "
+    "in=(%.6f,%.6f,%.6f) requested_out=(%.6f,%.6f,%.6f) "
+    "publication=%s reason=%s sources=%s previous=%s steady_ns=%lld",
+    name, navlite_region_.c_str(), published, zero,
+    navlite_input_.x, navlite_input_.y, navlite_input_.tw,
+    action.req_vel.x, action.req_vel.y, action.req_vel.tw,
+    published ? "sent" : "no_message", reason, navlite_sources_.empty() ? "none" : navlite_sources_.c_str(), previous.c_str(),
+    static_cast<long long>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+      stamp.time_since_epoch()).count()));
 }
 
