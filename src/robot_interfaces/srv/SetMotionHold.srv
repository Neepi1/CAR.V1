uint8 OP_ACQUIRE=0
uint8 OP_RELEASE=1

string owner
string transaction_id
string reason
uint8 operation
# Monotonic per (owner, transaction_id). Zero is legacy-only and is rejected
# after the key has accepted any sequenced command.
uint64 command_sequence
---
uint8 RESULT_OK=0
uint8 RESULT_INVALID_REQUEST=1
uint8 RESULT_CONFLICT=2
uint8 RESULT_NOT_OWNER=3
uint8 RESULT_STALE_LEASE=4
uint8 RESULT_STALE_COMMAND=5

bool success
uint8 result_code
string message
# Last accepted sequence for the exact (owner, transaction_id) key.
uint64 applied_sequence
robot_interfaces/MotionInterlockState state
