<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="navigate_elevator_reverse_docking">
      <RecoveryNode number_of_retries="60" name="wait_for_reverse_docking_corridor">
        <ComputePathToPose
          goal="{goal}"
          path="{path}"
          planner_id="ElevatorReverseDockingScoped"/>
        <Wait wait_duration="0.5"/>
      </RecoveryNode>
      <FollowPath
        path="{path}"
        controller_id="ElevatorReverseDockingFollowPath"
        goal_checker_id="goal_checker"/>
    </Sequence>
  </BehaviorTree>
</root>
