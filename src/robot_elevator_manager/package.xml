<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_elevator_manager</name>
  <version>0.1.0</version>
  <description>Fail-closed versioned elevator topology and orchestration core.</description>
  <maintainer email="robot@example.com">robot team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>robot_floor_manager</test_depend>
  <test_depend>robot_localization_bridge</test_depend>
  <test_depend>robot_mission_manager</test_depend>
  <test_depend>robot_mode_manager</test_depend>
  <test_depend>robot_safety</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
